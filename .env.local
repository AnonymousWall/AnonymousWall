# Local Testing Environment Configuration
# Copy this file to .env for local testing with docker-compose.local.yml
# This setup uses Oracle Database XE to mimic production Oracle ADB behavior

# ===========================================
# JWT Configuration
# ===========================================
# For local testing, a simple key is fine
# Production should use: openssl rand -base64 32
JWT_GENERATOR_SIGNATURE_SECRET=LocalTestingSecretKey32CharsMin!!!

# ===========================================
# Oracle Database Configuration (Local Testing)
# ===========================================
# Uses Oracle XE container to mimic production Oracle ADB
# Database: Oracle Database Express Edition 21c
# Default connection to XEPDB1 pluggable database
DATABASE_URL=jdbc:oracle:thin:@oracle-db:1521/XEPDB1
DATABASE_USER=system
DATABASE_PASSWORD=OraclePass123!

# ===========================================
# Redis Configuration
# ===========================================
REDIS_URI=redis://redis:6379

# ===========================================
# Email Configuration (Optional)
# ===========================================
# Configure SMTP for testing email verification
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=your-test-email@gmail.com
# SMTP_PASSWORD=your-app-password
