# Environment Configuration for AnonymousWall Backend
# Copy this file to .env and update with your actual values
# NEVER commit the .env file to version control!

# ===========================================
# REQUIRED - JWT Configuration
# ===========================================
# Generate a secure random string (minimum 32 characters)
# Example: openssl rand -base64 32
# IMPORTANT: This MUST be changed for any environment!
JWT_GENERATOR_SIGNATURE_SECRET=

# ===========================================
# REQUIRED - Database Configuration (OCI Autonomous Database)
# ===========================================
# OCI Autonomous Database (ADB) uses Oracle Database with mTLS (wallet required)
# Get connection details from Terraform output: adb_connection_strings
# 
# IMPORTANT: The infrastructure uses mTLS, so you need the wallet:
# 1. Extract wallet: terraform output -raw adb_wallet_content | base64 -d > wallet.zip
# 2. Unzip to /opt/anonymouswall/wallet on the deployment server
# 3. Use TNS alias from wallet's tnsnames.ora file (e.g., anonwalldb_high)
#
# Connection URL format with wallet:
# DATABASE_URL=jdbc:oracle:thin:@<tns-alias>?TNS_ADMIN=/app/wallet
#
# Example (using default infrastructure settings):
# DATABASE_URL=jdbc:oracle:thin:@anonwalldb_high?TNS_ADMIN=/app/wallet
DATABASE_URL=jdbc:oracle:thin:@anonwalldb_high?TNS_ADMIN=/app/wallet
DATABASE_USER=ADMIN
DATABASE_PASSWORD=YourComplexPassword123!@#

# ===========================================
# REQUIRED (multi-instance) - Redis Configuration
# ===========================================
# Redis is required for WebSocket broadcasting to work correctly when
# running multiple backend instances behind a load balancer.
# Without Redis, WebSocket pushes only reach users connected to the same
# instance that handles the outbound message.
#
# Single-instance / local dev: leave as localhost default
REDIS_URI=redis://localhost:6379
#
# Production (OCI Redis with password auth):
# REDIS_URI=redis://:YOUR_REDIS_PASSWORD@REDIS_PRIVATE_IP:6379
# Get REDIS_PRIVATE_IP with: terraform output redis_private_ip

# ===========================================
# OPTIONAL - MySQL Root Password (for local dev only)
# ===========================================
# Only used with docker-compose.yml (not prod)
# Local development uses MySQL, production uses Oracle ADB
MYSQL_ROOT_PASSWORD=rootpassword

# ===========================================
# OPTIONAL - Email Configuration
# ===========================================
# Configure SMTP for sending verification emails
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# ===========================================
# OPTIONAL - Image Configuration
# ===========================================
# Docker image tag for deployment
IMAGE_TAG=latest

# ===========================================
# OPTIONAL - OCI Object Storage (Production media uploads)
# ===========================================
# OCI namespace and bucket details for post image uploads in production
OCI_NAMESPACE=your-oci-namespace
MEDIA_BUCKET_NAME=your-media-bucket-name
MEDIA_BUCKET_URL=https://objectstorage.region.oraclecloud.com/n/your-namespace/b/your-bucket/o
