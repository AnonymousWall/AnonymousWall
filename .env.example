# Environment Configuration for AnonymousWall Backend
# Copy this file to .env and update with your actual values
# NEVER commit the .env file to version control!

# ===========================================
# REQUIRED - JWT Configuration
# ===========================================
# Generate a secure random string (minimum 32 characters)
# Example: openssl rand -base64 32
# IMPORTANT: This MUST be changed for any environment!
JWT_GENERATOR_SIGNATURE_SECRET=

# ===========================================
# REQUIRED - Database Configuration (OCI Autonomous Database)
# ===========================================
# OCI Autonomous Database (ADB) uses Oracle Database
# Get connection details from Terraform output: adb_connection_strings
# 
# Connection URL format options:
# 1. Using TNS alias with wallet: jdbc:oracle:thin:@<tns-alias>?TNS_ADMIN=/path/to/wallet
# 2. Using TCPS connection string: jdbc:oracle:thin:@(description=(...))
#
# Example with TNS alias:
# DATABASE_URL=jdbc:oracle:thin:@myatp_high?TNS_ADMIN=/app/wallet
#
# Example with full connection string (get from OCI Console):
# DATABASE_URL=jdbc:oracle:thin:@(description=(retry_count=20)(retry_delay=3)(address=(protocol=tcps)(port=1522)(host=adb.region.oraclecloud.com))(connect_data=(service_name=xxx_high.adb.oraclecloud.com))(security=(ssl_server_dn_match=yes)))
DATABASE_URL=jdbc:oracle:thin:@your-adb-connection-string
DATABASE_USER=ADMIN
DATABASE_PASSWORD=YourComplexPassword123!@#

# ===========================================
# OPTIONAL - Redis Configuration
# ===========================================
# Redis connection string
# Default: redis://localhost:6379 if not specified
REDIS_URI=redis://localhost:6379

# ===========================================
# OPTIONAL - MySQL Root Password (for local dev only)
# ===========================================
# Only used with docker-compose.yml (not prod)
# Local development uses MySQL, production uses Oracle ADB
MYSQL_ROOT_PASSWORD=rootpassword

# ===========================================
# OPTIONAL - Email Configuration
# ===========================================
# Configure SMTP for sending verification emails
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# ===========================================
# OPTIONAL - Image Configuration
# ===========================================
# Docker image tag for deployment
IMAGE_TAG=latest
