<?xml version="1.0" encoding="UTF-8"?>
<!--
    Log4j2 Configuration for Production Security
    
    Security Hardening:
    1. Configuration status set to "warn" to minimize internal logging
    2. Strict mode enabled to prevent configuration errors from being ignored
    3. shutdownHook enabled for graceful shutdown
    4. shutdownTimeout ensures logs are flushed on shutdown
-->
<Configuration status="warn" 
               packages="com.anonymous.wall"
               strict="true"
               shutdownHook="enable"
               shutdownTimeout="5000">
    <!-- 
        Property Configuration
        - log.dir: Set via LOG_DIR environment variable (dev: ./logs, prod: /var/log/anonymouswall)
        - log.pattern: Safe pattern without message lookups
        - Security: Use %m (not %msg{}) to prevent message pattern lookups
    -->
    <Properties>
        <Property name="log.dir">${env:LOG_DIR:-./logs}</Property>
        <!-- Use %m instead of %msg to prevent message pattern lookups (security) -->
        <Property name="log.pattern">%d{ISO8601} [%t] %-5level %logger{36} - %m%n</Property>
        <Property name="app.name">anonymouswall</Property>
    </Properties>

    <Appenders>
        <!-- 
            Console Appender: Primary output for all environments
            - Used in containerized environments where logs are captured by orchestration
            - No security concerns with console output
        -->
        <Console name="Console" target="SYSTEM_OUT">
            <PatternLayout pattern="${log.pattern}"/>
        </Console>

        <!-- 
            File Appender: Main application logs (OPTIONAL)
            - ignoreExceptions="true": Won't crash app if file system is unavailable
            - createOnDemand="true": Only creates files when needed (saves resources)
            - File permissions controlled by OS umask (typically 644 or 640)
            - Rolls over daily or at 10MB
            - Keeps 30 days of logs
        -->
        <RollingFile name="ApplicationFile"
                      fileName="${log.dir}/${app.name}.log"
                      filePattern="${log.dir}/${app.name}-%d{yyyy-MM-dd}-%i.log.gz"
                      ignoreExceptions="true"
                      createOnDemand="true">
            <PatternLayout pattern="${log.pattern}"/>
            <Policies>
                <!-- Roll over every day or when file size reaches 10MB -->
                <TimeBasedTriggeringPolicy interval="1" modulate="true"/>
                <SizeBasedTriggeringPolicy size="10MB"/>
            </Policies>
            <DefaultRolloverStrategy max="30"/>
        </RollingFile>

        <!-- 
            File Appender: Error logs only (OPTIONAL)
            - Same security settings as ApplicationFile
            - Only captures ERROR level and above
        -->
        <RollingFile name="ErrorFile"
                      fileName="${log.dir}/${app.name}-error.log"
                      filePattern="${log.dir}/${app.name}-error-%d{yyyy-MM-dd}-%i.log.gz"
                      ignoreExceptions="true"
                      createOnDemand="true">
            <PatternLayout pattern="${log.pattern}"/>
            <Policies>
                <TimeBasedTriggeringPolicy interval="1" modulate="true"/>
                <SizeBasedTriggeringPolicy size="10MB"/>
            </Policies>
            <DefaultRolloverStrategy max="30"/>
            <Filters>
                <ThresholdFilter level="ERROR" onMatch="ACCEPT" onMismatch="DENY"/>
            </Filters>
        </RollingFile>

        <!-- 
            File Appender: Application debug logs (OPTIONAL)
            - Same security settings as ApplicationFile
            - Only keeps 10 days (less retention for verbose debug logs)
        -->
        <RollingFile name="DebugFile"
                      fileName="${log.dir}/${app.name}-debug.log"
                      filePattern="${log.dir}/${app.name}-debug-%d{yyyy-MM-dd}-%i.log.gz"
                      ignoreExceptions="true"
                      createOnDemand="true">
            <PatternLayout pattern="${log.pattern}"/>
            <Policies>
                <TimeBasedTriggeringPolicy interval="1" modulate="true"/>
                <SizeBasedTriggeringPolicy size="10MB"/>
            </Policies>
            <DefaultRolloverStrategy max="10"/>
            <Filters>
                <ThresholdFilter level="DEBUG" onMatch="ACCEPT" onMismatch="DENY"/>
            </Filters>
        </RollingFile>
    </Appenders>

    <Loggers>
        <!-- Micronaut Framework -->
        <Logger name="io.micronaut.runtime" level="info" additivity="false">
            <AppenderRef ref="Console"/>
            <AppenderRef ref="ApplicationFile"/>
        </Logger>

        <!-- Application Logs -->
        <Logger name="com.anonymous.wall" level="debug" additivity="false">
            <AppenderRef ref="Console"/>
            <AppenderRef ref="ApplicationFile"/>
            <AppenderRef ref="DebugFile"/>
        </Logger>

        <!-- Micronaut HTTP: request/response logging -->
        <Logger name="io.micronaut.http" level="info" additivity="false">
            <AppenderRef ref="Console"/>
            <AppenderRef ref="ApplicationFile"/>
        </Logger>

        <!-- Micronaut Data / JPA: SQL queries -->
        <Logger name="io.micronaut.data" level="info" additivity="false">
            <AppenderRef ref="Console"/>
            <AppenderRef ref="ApplicationFile"/>
        </Logger>

        <!-- Hibernate/JPA -->
        <Logger name="org.hibernate" level="warn" additivity="false">
            <AppenderRef ref="Console"/>
            <AppenderRef ref="ApplicationFile"/>
        </Logger>

        <!-- Root Logger: catch-all for other libraries -->
        <Root level="warn">
            <AppenderRef ref="Console"/>
            <AppenderRef ref="ApplicationFile"/>
            <AppenderRef ref="ErrorFile"/>
        </Root>
    </Loggers>
</Configuration>
