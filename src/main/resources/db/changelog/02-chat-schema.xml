<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
       http://www.liquibase.org/xml/ns/dbchangelog
       http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <!-- ================= Chat Rooms ================= -->
    <changeSet id="10-create-chat-rooms-table" author="copilot">
        <createTable tableName="chat_rooms">
            <column name="id" type="CHAR(36)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(255)">
                <constraints nullable="true"/>
            </column>
            <column name="type" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="school_domain" type="VARCHAR(255)"/>
            <column name="created_by" type="CHAR(36)">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP"/>
            <column name="updated_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP"/>
        </createTable>
        <addForeignKeyConstraint baseTableName="chat_rooms" baseColumnNames="created_by"
                                 constraintName="fk_chat_rooms_created_by"
                                 referencedTableName="users" referencedColumnNames="id"/>
        <createIndex tableName="chat_rooms" indexName="idx_chat_rooms_type">
            <column name="type"/>
        </createIndex>
        <createIndex tableName="chat_rooms" indexName="idx_chat_rooms_school_domain">
            <column name="school_domain"/>
        </createIndex>
    </changeSet>

    <!-- ================= Room Members ================= -->
    <changeSet id="11-create-room-members-table" author="copilot">
        <createTable tableName="room_members">
            <column name="room_id" type="CHAR(36)">
                <constraints nullable="false"/>
            </column>
            <column name="user_id" type="CHAR(36)">
                <constraints nullable="false"/>
            </column>
            <column name="joined_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP"/>
            <column name="last_read_at" type="TIMESTAMP"/>
            <column name="is_muted" type="BOOLEAN" defaultValueBoolean="false"/>
        </createTable>
        <addPrimaryKey tableName="room_members" columnNames="room_id,user_id"
                       constraintName="pk_room_members"/>
        <addForeignKeyConstraint baseTableName="room_members" baseColumnNames="room_id"
                                 constraintName="fk_room_members_room"
                                 referencedTableName="chat_rooms" referencedColumnNames="id"
                                 onDelete="CASCADE"/>
        <addForeignKeyConstraint baseTableName="room_members" baseColumnNames="user_id"
                                 constraintName="fk_room_members_user"
                                 referencedTableName="users" referencedColumnNames="id"
                                 onDelete="CASCADE"/>
        <createIndex tableName="room_members" indexName="idx_room_members_user_id">
            <column name="user_id"/>
        </createIndex>
    </changeSet>

    <!-- ================= Chat Messages ================= -->
    <changeSet id="12-create-chat-messages-table" author="copilot">
        <createTable tableName="chat_messages">
            <column name="id" type="CHAR(36)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="room_id" type="CHAR(36)">
                <constraints nullable="false"/>
            </column>
            <column name="user_id" type="CHAR(36)">
                <constraints nullable="false"/>
            </column>
            <column name="profile_name" type="VARCHAR(255)" defaultValue="Anonymous"/>
            <column name="content" type="TEXT">
                <constraints nullable="false"/>
            </column>
            <column name="is_deleted" type="BOOLEAN" defaultValueBoolean="false"/>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP"/>
        </createTable>
        <addForeignKeyConstraint baseTableName="chat_messages" baseColumnNames="room_id"
                                 constraintName="fk_chat_messages_room"
                                 referencedTableName="chat_rooms" referencedColumnNames="id"
                                 onDelete="CASCADE"/>
        <addForeignKeyConstraint baseTableName="chat_messages" baseColumnNames="user_id"
                                 constraintName="fk_chat_messages_user"
                                 referencedTableName="users" referencedColumnNames="id"
                                 onDelete="CASCADE"/>
        <createIndex tableName="chat_messages" indexName="idx_chat_messages_room_id">
            <column name="room_id"/>
        </createIndex>
        <createIndex tableName="chat_messages" indexName="idx_chat_messages_created_at">
            <column name="created_at"/>
        </createIndex>
        <createIndex tableName="chat_messages" indexName="idx_chat_messages_user_id">
            <column name="user_id"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
