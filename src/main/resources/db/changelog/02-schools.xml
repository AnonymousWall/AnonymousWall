    <!-- ================= Schools Table ================= -->
    <changeSet id="15-create-schools-table" author="copilot">
        <comment>Create table for schools</comment>
        <createTable tableName="schools">
            <column name="id" type="CHAR(36)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(255)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP"/>
        </createTable>
        <createIndex tableName="schools" indexName="idx_schools_name">
            <column name="name"/>
        </createIndex>
    </changeSet>

    <!-- ================= School Domains Table ================= -->
    <changeSet id="16-create-school-domains-table" author="copilot">
        <comment>Create table for school email domains</comment>
        <createTable tableName="school_domains">
            <column name="id" type="CHAR(36)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="school_id" type="CHAR(36)">
                <constraints nullable="false"/>
            </column>
            <column name="domain" type="VARCHAR(255)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP"/>
        </createTable>
        <addForeignKeyConstraint baseTableName="school_domains" baseColumnNames="school_id"
                                 constraintName="fk_school_domains_school"
                                 referencedTableName="schools" referencedColumnNames="id"
                                 onDelete="CASCADE"/>
        <createIndex tableName="school_domains" indexName="idx_school_domains_domain">
            <column name="domain"/>
        </createIndex>
        <createIndex tableName="school_domains" indexName="idx_school_domains_school_id">
            <column name="school_id"/>
        </createIndex>
    </changeSet>

